{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "net-policy-gui",
  "version": "0.2.1",
  "identifier": "com.jmobserver.net-policy-gui",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "网络策略",
        "url": "index.html",
        "width": 900,
        "height": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$LOCALDATA/net-policy-gui/**",
          "$DATA/net-policy-gui/**",
          "$HOME/.config/net-policy-gui/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "resources": {
      "bundle-resources/net-policy-agent.exe": "net-policy-agent.exe",
      "bundle-resources/net-policy.exe": "net-policy.exe",
      "bundle-resources/mihomo-windows-amd64.exe": "mihomo-windows-amd64.pending.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Standalone network policy (egress control) desktop app.",
    "longDescription": "net-policy-gui is a standalone Tauri 2 shell hosting only the network policy (observer-first egress control) module, split out of zero-desktop."
  }
}
