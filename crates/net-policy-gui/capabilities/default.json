{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "main 窗口的默认权限（只有网络策略模块：invoke command + 事件订阅）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:path:default"
  ]
}
